{
  "name": "united-production-dispatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:sync-permissions": "tsx prisma/sync-permissions.ts",
    "test:rbac": "tsx --env-file-if-exists=.env tests/rbac.test.ts",
    "test:orders": "tsx --env-file-if-exists=.env tests/orders.test.ts",
    "test:data-import": "tsx --env-file-if-exists=.env tests/data-import.test.ts",
    "test:stock": "tsx --env-file-if-exists=.env tests/stock.test.ts",
    "test:product-master": "tsx --env-file-if-exists=.env tests/product-master.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:reset": "tsx --env-file-if-exists=.env tests/reset-db.ts",
    "test:unit": "node --env-file-if-exists=.env --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "npm run test:rbac && npm run test:orders && npm run test:stock && npm run test:product-master && npm run test:data-import && npm run test:core && npm run test:workflow && npm run test:documents && npm run test:inventory && npm run test:sales && npm run test:purchasing && npm run test:operations && npm run test:accounting && npm run test:hr && npm run test:integrations && npm run test:flows && npm run test:eta && npm run test:reset && npm run test:uat && npm run test:security && npm run test:scenarios && npm run test:robustness",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx --env-file-if-exists=.env tests/core.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:workflow": "tsx --env-file-if-exists=.env tests/workflow.test.ts",
    "test:documents": "tsx --env-file-if-exists=.env tests/documents.test.ts",
    "test:inventory": "tsx --env-file-if-exists=.env tests/inventory.test.ts",
    "test:sales": "tsx --env-file-if-exists=.env tests/sales.test.ts",
    "test:security": "tsx --env-file-if-exists=.env tests/security.test.ts",
    "test:accounting": "tsx --env-file-if-exists=.env tests/accounting.test.ts",
    "test:hr": "tsx --env-file-if-exists=.env tests/hr.test.ts",
    "test:integrations": "tsx --env-file-if-exists=.env tests/integrations.test.ts",
    "test:uat": "tsx --env-file-if-exists=.env tests/uat.test.ts",
    "test:scenarios": "tsx --env-file-if-exists=.env tests/scenarios.test.ts",
    "test:robustness": "tsx --env-file-if-exists=.env tests/robustness.test.ts",
    "test:eta": "tsx --env-file-if-exists=.env tests/eta.test.ts",
    "test:flows": "tsx --env-file-if-exists=.env tests/flows.test.ts",
    "test:operations": "tsx --env-file-if-exists=.env tests/operations.test.ts",
    "test:purchasing": "tsx --env-file-if-exists=.env tests/purchasing.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^14.2.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
